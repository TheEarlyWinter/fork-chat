{
  "manifestVersion": 2,
  "id": "timeline-reverser",
  "name": "分叉对话",
  "version": "1.5.2",
  "minAppVersion": "0.1050.9",
  "description": "打破线性聊天。树状多分支对话与模型推导工作台，支持向右分叉追问、独立回溯与真实模型流式推导。",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "capabilities": [
    "app/models.infer",
    "app/agents.read",
    "app/sessions.read",
    "app/ui.clipboard-write"
  ],
  "contributes": {
    "cards": [
      {
        "id": "timeline-compass",
        "title": "分叉对话",
        "description": "树状多分支对话与思维推导工作台",
        "route": "/panel.html",
        "realization": "page",
        "siteNavEntry": true,
        "fpFullPanel": true,
        "face": {
          "image": "assets/cover.png"
        },
        "functionPanel": {
          "id": "fork-model-panel",
          "label": "模型列表",
          "route": "/function-panel.html"
        }
      }
    ]
  }
}
